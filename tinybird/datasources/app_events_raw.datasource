DESCRIPTION >
    Raw custom events (OtaKit.track(), plugin 3.4+) from the ingest Worker.
    Properties are a JSON object of string values. Retries can repeat an
    event_id: count with uniqExact(event_id).

TOKEN otakit_ingest APPEND

SCHEMA >
    `event_id` String `json:$.event_id`,
    `received_at` DateTime64(3) `json:$.received_at`,
    `occurred_at` DateTime64(3) `json:$.occurred_at`,
    `app_id` String `json:$.app_id`,
    `platform` LowCardinality(String) `json:$.platform`,
    `release_id` Nullable(String) `json:$.release_id`,
    `bundle_version` String `json:$.bundle_version`,
    `channel` Nullable(String) `json:$.channel`,
    `runtime_version` Nullable(String) `json:$.runtime_version`,
    `native_build` String `json:$.native_build`,
    `os_version` Nullable(String) `json:$.os_version`,
    `sdk_version` Nullable(String) `json:$.sdk_version`,
    `session_id` String `json:$.session_id`,
    `name` LowCardinality(String) `json:$.name`,
    `properties` String `json:$.properties`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(received_at)"
ENGINE_SORTING_KEY "app_id, name, received_at"
ENGINE_TTL "toDateTime(received_at) + toIntervalDay(90)"
