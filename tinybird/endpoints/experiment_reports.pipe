DESCRIPTION >
    Reports of one A/B test in [from_day, to_day] (UTC days): devices per
    variant, kind and goal. With `daily`, per day too. Totals must come from
    the totals query: a retried report can land on two days.

TOKEN otakit_web READ

NODE experiment_reports
SQL >
    %
    SELECT
        {% if defined(daily) %}
            toString(day) AS report_day,
        {% else %}
            '' AS report_day,
        {% end %}
        variant,
        name,
        goal,
        uniqExactMerge(event_ids_uniq_exact_state) AS reports
    FROM app_experiment_daily
    WHERE app_id = {{ String(app_id, '__missing_app_id__') }}
      AND experiment_id = {{ String(experiment_id, '__missing_experiment_id__') }}
      AND day >= toDate({{ String(from_day, '1970-01-01') }})
      AND day <= toDate({{ String(to_day, '2100-01-01') }})
    GROUP BY
        {% if defined(daily) %}
            day,
        {% end %}
        variant,
        name,
        goal
    ORDER BY report_day, variant, name, goal
    LIMIT 20000

TYPE ENDPOINT
