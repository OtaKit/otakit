DESCRIPTION >
    Recent device-event timeline for a single app.

TOKEN otakit_web READ

NODE fetch_recent_events
SQL >
    %
    SELECT
        event_id,
        app_id,
        action,
        platform,
        bundle_version,
        channel,
        runtime_version,
        release_id,
        detail,
        received_at
    FROM device_events_raw
    WHERE app_id = {{ String(app_id, '__missing_app_id__') }}
      AND received_at >= parseDateTime64BestEffort({{ String(from_ts, '1970-01-01T00:00:00.000Z') }}, 3)
      AND ({{ String(platform, '') }} = '' OR platform = {{ String(platform, '') }})
      AND ({{ String(action, '') }} = '' OR action = {{ String(action, '') }})
      AND ({{ String(bundle_version, '') }} = '' OR bundle_version = {{ String(bundle_version, '') }})
      {% if defined(channel_is_null) %}
        AND (({{ UInt8(channel_is_null) }} = 1 AND coalesce(channel, '') = '')
             OR ({{ UInt8(channel_is_null) }} = 0
                 AND ({{ String(channel, '') }} = '' OR channel = {{ String(channel, '') }})))
      {% else %}
        -- Backward compatibility for consoles that used "base" as the
        -- no-channel sentinel before channel_is_null was introduced.
        AND ({{ String(channel, '') }} = ''
             OR ({{ String(channel, '') }} = 'base' AND coalesce(channel, '') = '')
             OR channel = {{ String(channel, '') }})
      {% end %}
      {% if defined(runtime_version_is_null) %}
        AND (({{ UInt8(runtime_version_is_null) }} = 1 AND coalesce(runtime_version, '') = '')
             OR ({{ UInt8(runtime_version_is_null) }} = 0
                 AND ({{ String(runtime_version, '') }} = '' OR runtime_version = {{ String(runtime_version, '') }})))
      {% else %}
        AND ({{ String(runtime_version, '') }} = '' OR runtime_version = {{ String(runtime_version, '') }})
      {% end %}
      AND ({{ String(release_id, '') }} = '' OR release_id = {{ String(release_id, '') }})
    ORDER BY received_at DESC
    LIMIT {{ UInt32(limit, 100) }}

TYPE ENDPOINT
