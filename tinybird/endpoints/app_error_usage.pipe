DESCRIPTION >
    Error events per app in [start_date, end_date_exclusive), for monthly plan caps.
    Without app_ids, every app with errors.

TOKEN otakit_web READ

NODE count_app_errors
SQL >
    %
    SELECT
        app_id,
        uniqExactMerge(event_ids_uniq_exact_state) AS events
    FROM app_error_daily
    WHERE bucket_date >= toDate({{ String(start_date, '1970-01-01') }})
      AND bucket_date < toDate({{ String(end_date_exclusive, '2100-01-01') }})
      AND ({{ String(app_ids, '') }} = '' OR has(splitByChar(',', {{ String(app_ids, '') }}), app_id))
    GROUP BY app_id
    ORDER BY app_id

TYPE ENDPOINT
