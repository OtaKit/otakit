DESCRIPTION >
    Issues of one app in a time range, with optional channel, release, platform and
    fingerprint filters. Reads raw errors (30 days).

TOKEN otakit_web READ

NODE filtered_errors
SQL >
    %
    SELECT *
    FROM app_errors_raw
    WHERE app_id = {{ String(app_id, '__missing_app_id__') }}
      AND received_at >= parseDateTime64BestEffort({{ String(from_ts, '1970-01-01T00:00:00.000Z') }}, 3)
      AND received_at < parseDateTime64BestEffort({{ String(to_ts, '2100-01-01T00:00:00.000Z') }}, 3)
      AND ({{ String(platform, '') }} = '' OR platform = {{ String(platform, '') }})
      AND ({{ String(release_id, '') }} = '' OR release_id = {{ String(release_id, '') }})
      {% if defined(channel_is_null) %}
        AND (({{ UInt8(channel_is_null) }} = 1 AND coalesce(channel, '') = '')
             OR ({{ UInt8(channel_is_null) }} = 0
                 AND ({{ String(channel, '') }} = '' OR channel = {{ String(channel, '') }})))
      {% end %}
      AND ({{ String(fingerprints, '') }} = ''
           OR has(splitByChar(',', {{ String(fingerprints, '') }}), fingerprint))

NODE issue_rows
SQL >
    %
    SELECT
        fingerprint,
        any(error_name) AS error_name,
        any(normalized_message) AS normalized_message,
        any(top_frame) AS top_frame,
        argMax(message, received_at) AS last_message,
        uniqExact(event_id) AS events,
        uniqExact(session_id) AS sessions,
        uniqExact(release_id) AS releases,
        max(handled) AS any_handled,
        min(handled) AS all_handled,
        groupUniqArray(platform) AS platforms,
        toUnixTimestamp64Milli(min(received_at)) AS first_seen_ms,
        toUnixTimestamp64Milli(max(received_at)) AS last_seen_ms
    FROM filtered_errors
    GROUP BY fingerprint
    ORDER BY
        CASE WHEN {{ String(sort, 'events') }} = 'last_seen' THEN last_seen_ms ELSE toInt64(events) END DESC,
        last_seen_ms DESC
    LIMIT {{ UInt32(limit, 500) }}

TYPE ENDPOINT
