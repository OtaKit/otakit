{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.otakit/otakit",
  "description": "Inspect, upload, release, monitor, and revert OtaKit Capacitor OTA updates.",
  "repository": {
    "url": "https://github.com/OtaKit/otakit",
    "source": "github"
  },
  "version": "1.5.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@otakit/cli",
      "version": "1.5.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://console.otakit.app/mcp"
    }
  ]
}
