{
  "name": "@otakit/console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && next dev",
    "build": "node ../../scripts/generate-llms-txt.mjs && pnpm db:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate && pnpm --filter @otakit/push-server db:generate",
    "db:migrate": "pnpm --filter @otakit/push-server db:migrate && prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@base-ui/react": "^1.1.0",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/server": "2.0.0",
    "@otakit/mcp-core": "workspace:*",
    "@otakit/push-server": "workspace:*",
    "@polar-sh/nextjs": "^0.9.3",
    "@polar-sh/sdk": "^0.42.5",
    "@prisma/adapter-pg": "6.19.2",
    "@prisma/client": "^6.19.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^3.9.9",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clipboardy": "^5.2.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.6.0",
    "recharts": "^2.15.4",
    "resend": "^6.9.1",
    "semver": "^7.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.8",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
