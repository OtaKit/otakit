generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  ios
  android
}

enum MemberRole {
  owner
  admin
  member
}

// ── Better Auth core tables ─────────────────────────────────────────

model User {
  id                   String        @id
  name                 String
  email                String        @unique
  emailVerified        Boolean       @default(false)
  image                String?
  activeOrganizationId String?
  activeOrganization   Organization? @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sessions           Session[]
  accounts           Account[]
  memberships        OrganizationMember[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Better Auth MCP/OAuth tables (inactive until explicitly enabled) ──

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]              @default([])
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]              @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]              @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]              @default([])
  responseTypes                    String[]              @default([])
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]
  resources                        OauthClientResource[]

  @@index([userId])
  @@map("OAuthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]              @default([])
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("OAuthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("OAuthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("OAuthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("OAuthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  scopes                  String[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([clientId, userId, referenceId])
  @@map("OAuthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("OAuthClientAssertion")
}

// ── Billing enums ───────────────────────────────────────────────────

enum PlanKey {
  free
  starter
  pro
  enterprise
}

enum UsageWarningSent {
  none
  at90
  at100
}

enum UploadSessionStatus {
  initiated
  finalized
  expired
}

enum ReleaseMutationOperation {
  publish
  revert
}

enum ReleaseMutationStatus {
  database_committed
  published
}

// ── Organizations & membership ──────────────────────────────────────

model Organization {
  id                  String               @id @default(uuid())
  name                String
  // Billing (Polar)
  planKey             PlanKey              @default(free)
  // Persists the Free-tier allowance an organization was granted. Existing
  // Free organizations are grandfathered at 100k; new organizations get 5k.
  freeDownloadsLimit  Int                  @default(5000)
  isActive            Boolean              @default(false)
  polarCustomerId     String?
  polarSubscriptionId String?
  usagePeriodStart    DateTime?
  usageCalculatedAt   DateTime?
  downloadsCount      Int                  @default(0)
  usageBlocked        Boolean              @default(false)
  overageEnabled      Boolean              @default(false)
  warningSent         UsageWarningSent     @default(none)
  // Relations
  apps                App[]
  apiKeys             OrganizationApiKey[]
  members             OrganizationMember[]
  invites             OrganizationInvite[]
  auditLogs           AuditLog[]
  releaseMutations    ReleaseMutation[]
  activeForUsers      User[]               @relation("UserActiveOrganization")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           MemberRole   @default(member)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model OrganizationInvite {
  id              String       @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  email           String
  role            MemberRole   @default(member)
  createdByUserId String?
  createdAt       DateTime     @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?

  @@index([email, acceptedAt])
  @@index([organizationId, createdAt(sort: Desc)])
}

model OrganizationApiKey {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  keyHash        String       @unique
  keyPrefix      String
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, revokedAt])
}

model AuditLog {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  // 'user' (dashboard session), 'key' (CLI/API key), 'system' (signup provisioning etc.)
  actorType      String
  actorId        String?
  // Resolved at write time (email or "api-key:<name>") so entries survive
  // member removal and key revocation.
  actorLabel     String
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
}

// ── App & bundles ───────────────────────────────────────────────────

model App {
  id             String          @id @default(uuid())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  slug           String
  bundles        Bundle[]
  releases       Release[]
  uploadSessions UploadSession[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, createdAt(sort: Desc)])
}

model Bundle {
  id                 String          @id @default(uuid())
  app                App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId              String
  version            String
  sha256             String
  storageKey         String
  size               Int
  runtimeVersion     String?
  // 'zip' (single archive) or 'deltas' (per-file content-addressed objects;
  // storageKey points at the canonical file-list object, sha256 = filesHash)
  strategy           String          @default("zip")
  metadata           Json?
  nativePackages     Json?
  encryption         Json?
  createdAt          DateTime        @default(now())
  releases           Release[]       @relation("ReleaseBundle")
  previousInReleases Release[]       @relation("ReleasePreviousBundle")
  uploadSessions     UploadSession[]

  @@unique([appId, version])
  @@index([appId, createdAt(sort: Desc)])
}

model Release {
  id                       String    @id @default(uuid())
  app                      App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId                    String
  bundle                   Bundle    @relation("ReleaseBundle", fields: [bundleId], references: [id], onDelete: Restrict)
  bundleId                 String
  previousBundle           Bundle?   @relation("ReleasePreviousBundle", fields: [previousBundleId], references: [id], onDelete: SetNull)
  previousBundleId         String?
  channel                  String?
  forceImmediate           Boolean   @default(false)
  autoRevert               Boolean   @default(false)
  autoRevertRatePercent    Int       @default(20)
  autoRevertMinSample      Int       @default(50)
  promotedAt               DateTime  @default(now())
  promotedBy               String?
  revertedAt               DateTime?
  revertedBy               String?
  autoRevertAlertPayload   Json?
  autoRevertAlertClaimedAt DateTime?
  autoRevertAlertedAt      DateTime?

  @@index([appId, channel, promotedAt(sort: Desc)])
  @@index([bundleId, promotedAt(sort: Desc)])
  @@index([autoRevertAlertedAt, autoRevertAlertClaimedAt])
}

model ReleaseMutation {
  id             String                   @id @default(uuid())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  actorKey       String
  operation      ReleaseMutationOperation
  idempotencyKey String
  requestHash    String
  status         ReleaseMutationStatus
  appId          String
  releaseId      String?
  channel        String?
  runtimeVersion String?
  result         Json?
  errorMessage   String?
  expiresAt      DateTime
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Postgres truncates identifiers at 63 bytes and would store
  // "…_idempotencyKe", while Prisma's own generated name truncates the middle.
  // Naming it explicitly keeps the database and the schema in agreement.
  @@unique([organizationId, actorKey, operation, idempotencyKey], map: "ReleaseMutation_organizationId_actorKey_operation_idempoten_key")
  @@index([status, updatedAt])
  @@index([appId, channel, runtimeVersion, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model UploadSession {
  id             String              @id @default(uuid())
  app            App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId          String
  version        String
  expectedSha256 String
  expectedSize   Int
  actualSize     Int?
  runtimeVersion String?
  // 'zip' or 'deltas'; for deltas, files holds the validated
  // [{ path, sha256, size }] list carried from initiate to finalize
  strategy       String              @default("zip")
  files          Json?
  metadata       Json?
  nativePackages Json?
  encryption     Json?
  storageKey     String
  status         UploadSessionStatus @default(initiated)
  bundle         Bundle?             @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  bundleId       String?
  expiresAt      DateTime
  finalizedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([appId, status, createdAt(sort: Desc)])
  @@index([expiresAt, status])
  @@index([bundleId])
}
