generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  ios
  android
}

enum MemberRole {
  owner
  admin
  member
}

// ── Better Auth core tables ─────────────────────────────────────────

model User {
  id                   String        @id
  name                 String
  email                String        @unique
  emailVerified        Boolean       @default(false)
  image                String?
  activeOrganizationId String?
  activeOrganization   Organization? @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  sessions           Session[]
  accounts           Account[]
  memberships        OrganizationMember[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  /// Written by Better Auth 1.7.0-1.7.2 only. Since 1.7.3 accounts are keyed by
  /// (providerId, accountId) again and new rows leave this empty; kept for the
  /// existing rows, dropping it is separate cleanup.
  issuer                String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Better Auth MCP/OAuth tables (inactive until explicitly enabled) ──

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]              @default([])
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime              @default(now())
  updatedAt                        DateTime              @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]              @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]              @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]              @default([])
  responseTypes                    String[]              @default([])
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]
  resources                        OauthClientResource[]

  @@index([userId])
  @@map("OAuthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]              @default([])
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("OAuthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("OAuthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("OAuthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("OAuthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  scopes                  String[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([clientId, userId, referenceId])
  @@map("OAuthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("OAuthClientAssertion")
}

// ── Billing enums ───────────────────────────────────────────────────

enum PlanKey {
  free
  starter
  pro
  enterprise
}

enum UsageWarningSent {
  none
  at90
  at100
}

enum UploadSessionStatus {
  initiated
  finalized
  expired
}

enum ReleaseMutationOperation {
  publish
  revert
  rollout
}

enum ReleaseMutationStatus {
  database_committed
  published
}

enum ErrorIssueStatus {
  open
  resolved
  ignored
}

enum NotificationDestinationType {
  email
  webhook
  slack
  discord
}

enum NotificationDeliveryStatus {
  pending
  sending
  delivered
  failed
}

// ── Organizations & membership ──────────────────────────────────────

model Organization {
  id                       String                    @id @default(uuid())
  name                     String
  // Billing (Polar)
  planKey                  PlanKey                   @default(free)
  // Persists the Free-tier allowance an organization was granted. Existing
  // Free organizations are grandfathered at 100k; new organizations get 5k.
  freeDownloadsLimit       Int                       @default(5000)
  isActive                 Boolean                   @default(false)
  polarCustomerId          String?
  polarSubscriptionId      String?
  usagePeriodStart         DateTime?
  usageCalculatedAt        DateTime?
  downloadsCount           Int                       @default(0)
  usageBlocked             Boolean                   @default(false)
  overageEnabled           Boolean                   @default(false)
  warningSent              UsageWarningSent          @default(none)
  // Add-ons (their data lives in their own packages and Postgres schemas)
  pushEnabled              Boolean                   @default(false)
  // Error tracking reached the plan's monthly cap: ingest drops new errors
  // until this time (the start of the next UTC month). Set by the errors cron.
  errorsPausedUntil        DateTime?
  // The same for custom events (OtaKit.track()).
  eventsPausedUntil        DateTime?
  // Relations
  apps                     App[]
  apiKeys                  OrganizationApiKey[]
  members                  OrganizationMember[]
  invites                  OrganizationInvite[]
  auditLogs                AuditLog[]
  releaseMutations         ReleaseMutation[]
  notificationDestinations NotificationDestination[]
  activeForUsers           User[]                    @relation("UserActiveOrganization")
  onboarding               OrganizationOnboarding?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

model OrganizationOnboarding {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version        Int          @default(1)
  answers        Json         @default("{}")
  step           String       @default("app")
  completedAt    DateTime?
  skippedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           MemberRole   @default(member)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}

model OrganizationInvite {
  id              String       @id @default(uuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  email           String
  role            MemberRole   @default(member)
  createdByUserId String?
  createdAt       DateTime     @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?

  @@index([email, acceptedAt])
  @@index([organizationId, createdAt(sort: Desc)])
}

model OrganizationApiKey {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  keyHash        String       @unique
  keyPrefix      String
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, revokedAt])
}

model AuditLog {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  // 'user' (dashboard session), 'key' (CLI/API key), 'system' (signup provisioning etc.)
  actorType      String
  actorId        String?
  // Resolved at write time (email or "api-key:<name>") so entries survive
  // member removal and key revocation.
  actorLabel     String
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
}

// ── App & bundles ───────────────────────────────────────────────────

model App {
  id                       String                    @id @default(uuid())
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId           String
  slug                     String
  // Custom URL scheme of the app (e.g. `myapp`), used to open preview links.
  previewUrlScheme         String?
  bundles                  Bundle[]
  releases                 Release[]
  uploadSessions           UploadSession[]
  previews                 BundlePreview[]
  notificationDestinations NotificationDestination[]
  remoteConfigs            RemoteConfig[]
  errorIssues              ErrorIssue[]
  experiments              Experiment[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, createdAt(sort: Desc)])
}

model Bundle {
  id                 String          @id @default(uuid())
  app                App             @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId              String
  version            String
  sha256             String
  storageKey         String
  size               Int
  runtimeVersion     String?
  // 'zip' (single archive) or 'deltas' (per-file content-addressed objects;
  // storageKey points at the canonical file-list object, sha256 = filesHash)
  strategy           String          @default("zip")
  metadata           Json?
  nativePackages     Json?
  encryption         Json?
  createdAt          DateTime        @default(now())
  releases           Release[]       @relation("ReleaseBundle")
  previousInReleases Release[]       @relation("ReleasePreviousBundle")
  uploadSessions     UploadSession[]
  previews           BundlePreview[]

  @@unique([appId, version])
  @@index([appId, createdAt(sort: Desc)])
}

model Release {
  id                       String    @id @default(uuid())
  app                      App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId                    String
  bundle                   Bundle    @relation("ReleaseBundle", fields: [bundleId], references: [id], onDelete: Restrict)
  bundleId                 String
  previousBundle           Bundle?   @relation("ReleasePreviousBundle", fields: [previousBundleId], references: [id], onDelete: SetNull)
  previousBundleId         String?
  channel                  String?
  forceImmediate           Boolean   @default(false)
  autoRevert               Boolean   @default(false)
  autoRevertRatePercent    Int       @default(20)
  autoRevertMinSample      Int       @default(50)
  // Share of devices (1-100) that receive this release. Below 100 it is an
  // active rollout: only the lane-current release can be rolling, and the
  // release below it stays the manifest's stable release. 100 is final.
  rolloutPercent           Int       @default(100)
  // Plain-text notes for this release (max 2,000 characters). Devices receive
  // them in a separately signed manifest block; editing republishes the lane.
  notes                    String?
  promotedAt               DateTime  @default(now())
  promotedBy               String?
  revertedAt               DateTime?
  revertedBy               String?
  // Deprecated: auto-revert alerts are notifications now. No longer written or
  // read; dropped once no deployment selects them.
  autoRevertAlertPayload   Json?
  autoRevertAlertClaimedAt DateTime?
  autoRevertAlertedAt      DateTime?
  // When the errors cron sent the errors.spike alert for this release.
  errorSpikeAlertedAt      DateTime?

  @@index([appId, channel, promotedAt(sort: Desc)])
  @@index([bundleId, promotedAt(sort: Desc)])
  @@index([autoRevertAlertedAt, autoRevertAlertClaimedAt])
}

// A private preview link: while it is active, a signed manifest for the bundle
// is served on the hidden channel `__preview_<token>`. The token is the
// capability; ended previews have their manifest deleted.
model BundlePreview {
  id        String    @id @default(uuid())
  app       App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId     String
  bundle    Bundle    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId  String
  token     String    @unique
  createdBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  // Revoked, or expired and cleaned up: the manifest no longer exists.
  endedAt   DateTime?

  @@index([appId, endedAt, expiresAt])
  @@index([bundleId, endedAt])
  @@index([endedAt, expiresAt])
}

model ReleaseMutation {
  id             String                   @id @default(uuid())
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  actorKey       String
  operation      ReleaseMutationOperation
  idempotencyKey String
  requestHash    String
  status         ReleaseMutationStatus
  appId          String
  releaseId      String?
  channel        String?
  runtimeVersion String?
  result         Json?
  errorMessage   String?
  expiresAt      DateTime
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Postgres truncates identifiers at 63 bytes and would store
  // "…_idempotencyKe", while Prisma's own generated name truncates the middle.
  // Naming it explicitly keeps the database and the schema in agreement.
  @@unique([organizationId, actorKey, operation, idempotencyKey], map: "ReleaseMutation_organizationId_actorKey_operation_idempoten_key")
  @@index([status, updatedAt])
  @@index([appId, channel, runtimeVersion, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model UploadSession {
  id             String              @id @default(uuid())
  app            App                 @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId          String
  version        String
  expectedSha256 String
  expectedSize   Int
  actualSize     Int?
  runtimeVersion String?
  // 'zip' or 'deltas'; for deltas, files holds the validated
  // [{ path, sha256, size }] list carried from initiate to finalize
  strategy       String              @default("zip")
  files          Json?
  metadata       Json?
  nativePackages Json?
  encryption     Json?
  storageKey     String
  status         UploadSessionStatus @default(initiated)
  bundle         Bundle?             @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  bundleId       String?
  expiresAt      DateTime
  finalizedAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([appId, status, createdAt(sort: Desc)])
  @@index([expiresAt, status])
  @@index([bundleId])
}

// ── Notifications ───────────────────────────────────────────────────

// Where a workspace's notifications go: email to members, Slack, Discord, or a
// signed webhook. Events are notification type names (lib/notifications/events.ts).
model NotificationDestination {
  id                       String                      @id @default(uuid())
  organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId           String
  // Only events of this app (plus workspace-wide ones); null = all apps.
  app                      App?                        @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId                    String?
  type                     NotificationDestinationType
  name                     String
  // Webhook, Slack and Discord URL.
  url                      String?
  // Email: { mode: 'owners_admins' } or { mode: 'members', userIds: [...] }.
  emailRecipients          Json?
  // Webhook signing secret (whsec_…), sealed with DATA_ENCRYPTION_KEY. After a
  // rotation the previous secret also signs until previousSecretExpiresAt.
  secretCiphertext         String?
  previousSecretCiphertext String?
  previousSecretExpiresAt  DateTime?
  events                   String[]
  enabled                  Boolean                     @default(true)
  // Set when OtaKit disabled it: 'endpoint_gone' (HTTP 410) or 'failing'.
  disabledReason           String?
  consecutiveFailures      Int                         @default(0)
  // First failed attempt since the last success; OtaKit turns URL destinations
  // off once they have failed for 72 hours.
  failingSince             DateTime?
  lastSuccessAt            DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  deliveries               NotificationDelivery[]

  @@index([organizationId])
  @@index([appId])
}

// One event for one destination: the outbox row, written in the same
// transaction as the change it reports. Its id is the webhook-id header.
model NotificationDelivery {
  id             String                     @id @default(uuid())
  destination    NotificationDestination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId  String
  eventType      String
  // Identifies the event, so replays and retries never create a second row.
  eventKey       String
  // Public event ID (payload `id`, header `webhook-id`): the same for every
  // destination, retry and redelivery of one event.
  eventId        String
  // The JSON body exactly as sent (text keeps its key order; JSONB would not).
  payload        String
  // Email: recipients already sent to, so a retry only reaches the others.
  emailSentTo    String[]                   @default([])
  // Manual redeliveries; part of the email idempotency key, so a redelivery
  // really sends again.
  redeliveries   Int                        @default(0)
  status         NotificationDeliveryStatus @default(pending)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  claimedAt      DateTime?
  lastAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?
  lastDurationMs Int?
  deliveredAt    DateTime?
  createdAt      DateTime                   @default(now())

  @@unique([destinationId, eventKey])
  @@index([status, nextAttemptAt])
  @@index([destinationId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/// Remote config of one channel of an app: a JSON object apps read with
/// OtaKit.getConfig() (plugin 3.4+). Every change is a new version; the signed
/// CDN file config/{appId}/{channelKey}/config.json is derived from the latest.
model RemoteConfig {
  id             String                @id @default(uuid())
  app            App                   @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId          String
  /// Null for the base channel.
  channel        String?
  /// `channel ?? '__base__'`: unique per app, the base channel included.
  channelKey     String
  /// Latest version. Versions start at 1 and never repeat, deletes included,
  /// so devices can refuse an older file (replay).
  currentVersion Int
  /// Version the CDN file was last written for; lower than currentVersion
  /// while a write is pending repair.
  syncedVersion  Int                   @default(0)
  /// When the file was last written. Signatures expire after a year, so old
  /// files are signed again.
  syncedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  versions       RemoteConfigVersion[]

  @@unique([appId, channelKey])
}

/// One published state of a channel's config, or its deletion.
model RemoteConfigVersion {
  id              String       @id @default(uuid())
  config          RemoteConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId        String
  version         Int
  /// Exactly the text devices receive and the signature covers; "{}" for a deletion.
  valuesJson      String
  /// Running experiments (A/B tests), exactly as signed; null when there are none.
  experimentsJson String?
  /// The channel's config was deleted in this version (a signed deletion file):
  /// devices on a named channel use the base config, base apps their defaults.
  deleted         Boolean      @default(false)
  /// Why it changed, shown in history and notifications.
  message         String?
  createdBy       String
  createdAt       DateTime     @default(now())

  @@unique([configId, version])
}

// An issue: the app errors with one fingerprint, which the ingest Worker
// computes. Counts and samples live in Tinybird (app_errors_raw); the errors
// cron keeps these rows in step, reopens regressions and sends alerts.
model ErrorIssue {
  id                 String           @id @default(uuid())
  app                App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId              String
  fingerprint        String
  status             ErrorIssueStatus @default(open)
  errorName          String
  normalizedMessage  String
  topFrame           String?
  // The release of the issue's first event; null on the built-in bundle.
  firstReleaseId     String?
  firstSeenAt        DateTime
  lastSeenAt         DateTime
  // Error events in the last 180 days, as of the last sync.
  eventCount         Int              @default(0)
  resolvedAt         DateTime?
  // The releases ('' = built-in bundle) the issue had happened on when it was
  // resolved. It reopens only when it happens on another release.
  resolvedReleaseIds String[]         @default([])
  statusChangedAt    DateTime?
  statusChangedBy    String?
  // How often the issue came back after it was resolved.
  regressions        Int              @default(0)
  newIssueAlertedAt  DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([appId, fingerprint])
  @@index([appId, status, lastSeenAt(sort: Desc)])
  @@index([appId, firstReleaseId])
}

enum ExperimentStatus {
  draft
  running
  stopped
  shipped
}

/// An A/B test. While it runs, it rides in its config file's signed
/// experimentsJson; devices report exposures, goals and errors at most once
/// each, counted in Tinybird (app_experiment_daily).
model Experiment {
  id               String           @id @default(uuid())
  app              App              @relation(fields: [appId], references: [id], onDelete: Cascade)
  appId            String
  /// Used in app code, getVariant(key); unique among the app's draft and running experiments.
  key              String
  name             String
  status           ExperimentStatus @default(draft)
  /// The config file it rides in; null = the base config.
  channel          String?
  /// `channel ?? '__base__'`, as for remote config.
  channelKey       String
  /// Device channels (null = the base channel) as a JSON array; null = every device of the file.
  audienceChannels Json?
  /// Device runtime versions; empty = every runtime version.
  runtimeVersions  String[]         @default([])
  trafficPercent   Int              @default(100)
  /// [{ key, weight, overrides }], control first. Locked while running.
  variants         Json
  goalEvent        String
  secondaryEvents  String[]         @default([])
  startedAt        DateTime?
  stoppedAt        DateTime?
  /// The variant whose values were written into the config when it ended.
  shippedVariant   String?
  /// The last verdict sent as experiment.verdict_reached ("winner:b", "no_difference", "guardrail:b").
  notifiedVerdict  String?
  /// When the telemetry cron last checked its results.
  resultsCheckedAt DateTime?
  createdBy        String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([appId, status])
  @@index([status, resultsCheckedAt])
}
