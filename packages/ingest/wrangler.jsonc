{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "otakit-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-12",
  "routes": [
    {
      "pattern": "ingest.otakit.app",
      "custom_domain": true,
    },
  ],
  "vars": {
    "TINYBIRD_API_HOST": "https://api.us-east.aws.tinybird.co",
    "TINYBIRD_EVENTS_DATASOURCE": "device_events_raw",
    "TINYBIRD_APP_ERRORS_DATASOURCE": "app_errors_raw",
    "TINYBIRD_APP_EVENTS_DATASOURCE": "app_events_raw",
  },
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "otakit-events",
      },
      {
        "binding": "APP_TELEMETRY_QUEUE",
        "queue": "otakit-app-telemetry",
      },
    ],
    "consumers": [
      {
        "queue": "otakit-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "otakit-events-dlq",
      },
      {
        "queue": "otakit-app-telemetry",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "otakit-app-telemetry-dlq",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "EVENTS_RATE_LIMITER",
      "namespace_id": "2026041201",
      "simple": {
        "limit": 5000,
        "period": 60,
      },
    },
    {
      "name": "APP_TELEMETRY_RATE_LIMITER",
      "namespace_id": "2026101401",
      "simple": {
        "limit": 2000,
        "period": 60,
      },
    },
  ],
}
